generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lab {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  description  String
  website      String
  headquarters String
  models       Model[]
}

model Provider {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  website   String
  offerings ModelProvider[]
}

model Model {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  description      String
  labId            String
  lab              Lab              @relation(fields: [labId], references: [id], onDelete: Cascade)
  contextWindow    Int
  maxOutputTokens  Int?
  parameterCount   String?
  architecture     String?
  modelType        String
  isOpenWeights    Boolean
  releaseDate      DateTime
  inputModalities  String[]
  outputModalities String[]
  capabilities     String[]
  providers        ModelProvider[]
  benchmarks       BenchmarkScore[]

  @@index([labId])
  @@index([modelType])
  @@index([contextWindow])
}

model ModelProvider {
  id               String   @id @default(cuid())
  modelId          String
  providerId       String
  model            Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  provider         Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  inputPricePer1M  Float
  outputPricePer1M Float
  latencyMs        Int?
  throughputTps    Int?
  quantization     String?
  isDefault        Boolean

  @@unique([modelId, providerId])
  @@index([inputPricePer1M])
}

model Benchmark {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  category    String
  description String
  maxScore    Float
  unit        String
  scores      BenchmarkScore[]
}

model BenchmarkScore {
  id          String    @id @default(cuid())
  modelId     String
  benchmarkId String
  model       Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  benchmark   Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)
  score       Float
  verified    Boolean

  @@unique([modelId, benchmarkId])
  @@index([benchmarkId, score(sort: Desc)])
}
